---
import { host, joinList, acuityUrl } from '../lib';
const { s } = Astro.props;
---
<article class="card subject-card">
  <h3><a href={`/${s.page}/`}>{s.label}</a></h3>
  <div class="tags">{s.boards.map((b: any) => <span class="tag">{b.short}</span>)}</div>
  <p>{s.blurb}</p>
  <div class="tutor-line">Tutor{s.tutors.length > 1 ? 's' : ''}: <strong>{joinList(s.tutors)}</strong></div>
  <div class="links">
    <a href={`/${s.page}/`}>Tutoring</a>
    {s.site && <a href={`${s.site}/`}>{s.external ? host(s.site) : 'Free revision site'} ↗</a>}
    {s.acuity && Object.keys(s.acuity).length === 1 && <a href={acuityUrl(Object.values(s.acuity)[0] as number)}>Book online ↗</a>}
  </div>
</article>
