---
import WaIcon from './WaIcon.astro';
import { waGeneral } from '../lib';
interface Props { heading?: string; text?: string; wa?: string; }
const {
  heading = 'Not sure where to start?',
  text = 'Send Tom the subject, exam board and year group, and a line about what’s worrying you. He reads every message himself and will suggest the right tutor.',
  wa = waGeneral(),
} = Astro.props;
---
<section class="block">
  <div class="wrap">
    <div class="lead-block">
      <div>
        <h2>{heading}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-wa" href={wa}><WaIcon /> WhatsApp Tom</a>
        <a class="btn btn-primary" href="/contact/">Send a message</a>
      </div>
    </div>
  </div>
</section>
