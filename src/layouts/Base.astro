---
import '../styles.css';
import site from '../data/site.json';
import subjects from '../data/subjects.json';
import { waGeneral, host } from '../lib';
import WaIcon from '../components/WaIcon.astro';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  noindex?: boolean;
  ogType?: string;
}
const { title, description, schema = [], noindex = false, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/subjects/', label: 'Subjects' },
  { href: '/tutors/', label: 'Tutors' },
  { href: '/free-revision/', label: 'Free revision' },
  { href: '/how-it-works/', label: 'How it works' },
  { href: '/revision-tips/', label: 'Revision tips' },
  { href: '/about/', label: 'About' },
];
const org = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': `${site.url}/#org`,
  name: site.name,
  legalName: site.company,
  url: `${site.url}/`,
  logo: `${site.url}/favicon-192.png`,
  email: site.email,
  areaServed: 'GB',
  sameAs: subjects.map((s) => `${s.site}/`),
};
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/favicon-192.png" />
  <meta name="theme-color" content="#14213d" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${site.url}/og.png`} />
  <meta property="og:locale" content="en_GB" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify([org, ...schema])} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label="aleveltutors.online home">
        <span class="mark" aria-hidden="true">A*</span>
        <span>aleveltutors<span class="dot">.</span>online</span>
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav class="nav" id="nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        <a class="btn btn-primary" href="/contact/">Find a tutor</a>
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <h3>aleveltutors.online</h3>
          <p>Online one-to-one A-level tuition from experienced A-level teachers, and free revision sites for every subject we teach.</p>
          <p><a href={waGeneral()}>WhatsApp us</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div>
          <h3>Tutoring</h3>
          <ul>
            {subjects.map((s) => <li><a href={`/${s.page}/`}>A-level {s.name} tutor</a></li>)}
          </ul>
        </div>
        <div>
          <h3>Free revision sites</h3>
          <ul>
            {subjects.map((s) => <li><a href={`${s.site}/`}>{host(s.site)}</a></li>)}
          </ul>
        </div>
        <div>
          <h3>Information</h3>
          <ul>
            <li><a href="/how-it-works/">How it works</a></li>
            <li><a href="/tutors/">Our tutors</a></li>
            <li><a href="/revision-tips/">Revision tips</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/terms/">Terms</a></li>
            <li><a href="/privacy/">Privacy</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-base">
        © {new Date().getFullYear()} {site.company}. Registered in England and Wales, company number {site.companyNumber}.
      </div>
    </div>
  </footer>
  <a class="wa-float" href={waGeneral()} aria-label="Message us on WhatsApp"><WaIcon size={30} /></a>
  <script>
    const t = document.querySelector('.menu-toggle');
    const n = document.getElementById('nav');
    t?.addEventListener('click', () => {
      const open = n!.classList.toggle('open');
      t.setAttribute('aria-expanded', String(open));
    });
  </script>
</body>
</html>
