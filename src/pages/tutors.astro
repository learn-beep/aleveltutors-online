---
import Base from '../layouts/Base.astro';
import LeadBlock from '../components/LeadBlock.astro';
import subjects from '../data/subjects.json';
import { joinList, acuityUrl, teamStats } from '../lib';
const rows = subjects.flatMap((s: any) => s.tutors.map((t: string) => ({ t, s, info: s.tutorInfo?.[t], id: s.acuity?.[t] })));
const { tutors, examiners, heads } = teamStats();
---
<Base title="Our Online A-level Tutors: Teachers and Examiners" description={`Meet our ${tutors} online tutors: experienced A-level specialists, ${examiners} current or former exam board examiners and ${heads} heads of department.`}>
  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Tutors</div>
      <h1>Our tutors</h1>
      <p>Experienced specialists, not students. Most teach, or have taught, A level in sixth form colleges. {examiners} have marked A-level exams for the exam boards and {heads} have led a department.</p>
    </div>
  </section>
  <section class="block">
    <div class="wrap">
      <h2 class="sr-only">All tutors</h2>
      <div class="grid grid-3">
        {rows.map(({ t, s, info, id }) => (
          <article class="card subject-card">
            <h3>{t}{s.slug === 'biology' ? ' Whitburn' : ''}</h3>
            <div class="tags"><span class="tag">{s.label}</span>{[...new Set(s.boards.map((b) => b.short))].map((t) => <span class="tag">{t}</span>)}</div>
            <p style="color:var(--ink)">{info}</p>
            {s.fee && <p><strong>{s.fee}</strong></p>}
            <div class="links">
              {id && <a href={acuityUrl(id)}>Book with {t} ↗</a>}
              <a href={`/${s.page}/`}>{s.name} tutoring</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <LeadBlock />
</Base>
