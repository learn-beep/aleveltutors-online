---
import Base from '../layouts/Base.astro';
import WaIcon from '../components/WaIcon.astro';
import subjects from '../data/subjects.json';
import site from '../data/site.json';
import { waGeneral } from '../lib';
---
<Base title="Find an Online A-level Tutor | Contact aleveltutors.online" description="Ask about online A-level tutoring by WhatsApp or the enquiry form. Tell us the subject, exam board and year group.">
  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Contact</div>
      <h1>Find a tutor</h1>
      <p>WhatsApp is quickest. Or send the form and we’ll reply by email.</p>
    </div>
  </section>
  <section class="block">
    <div class="wrap grid grid-2" style="align-items:start">
      <div>
        <h2>WhatsApp</h2>
        <p>The message is started for you. Add the subject, year group and exam board if you can.</p>
        <p><a class="btn btn-wa" href={waGeneral()}><WaIcon /> WhatsApp us</a></p>
        <h2 style="margin-top:32px">Email</h2>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <form class="enquiry" name="enquiry" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="company">
        <input type="hidden" name="form-name" value="enquiry" />
        <p class="hp"><label>Leave this empty <input name="company" /></label></p>
        <div class="row">
          <label>Your name <input name="name" required autocomplete="name" /></label>
          <label>Email <input type="email" name="email" required autocomplete="email" /></label>
        </div>
        <div class="row">
          <label>Subject
            <select name="subject" required>
              <option value="">Choose…</option>
              {subjects.map((s) => <option>{s.name}</option>)}
              <option>Other</option>
            </select>
          </label>
          <label>Exam board <input name="board" placeholder="e.g. AQA, OCR, Edexcel" /></label>
        </div>
        <div class="row">
          <label>Year group
            <select name="year">
              <option>Year 12</option><option>Year 13</option><option>Resitting</option><option>Year 11</option><option>Year 10</option><option>Other</option>
            </select>
          </label>
          <label>Phone (optional) <input name="phone" autocomplete="tel" /></label>
        </div>
        <label>How did you find us? (optional)
          <select name="source">
            <option value="">Choose…</option>
            <option>Google search</option><option>Recommendation</option><option>One of our free revision sites</option><option>School or college</option><option>Social media</option><option>Other</option>
          </select>
        </label>
        <label>What would you like help with? Best times for lessons?
          <textarea name="message" rows="5"></textarea>
        </label>
        <button class="btn btn-primary" type="submit">Send enquiry</button>
      </form>
    </div>
  </section>
</Base>
