---
import Base from '../layouts/Base.astro';
import SubjectCard from '../components/SubjectCard.astro';
import LeadBlock from '../components/LeadBlock.astro';
import subjects from '../data/subjects.json';
const alevel = subjects.filter((s) => s.level !== 'GCSE').length;
---
<Base title="A-level Subjects We Tutor Online | aleveltutors.online" description="Online A-level tutors in Maths, the Sciences, Psychology, Economics, Sociology, Geography, English, Law and more, for AQA, OCR, Edexcel, Eduqas and Cambridge.">
  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Subjects</div>
      <h1>A-level subjects we tutor</h1>
      <p>{alevel} A-level subjects and GCSE Science, each taught by a specialist teacher. Most also have a free revision site for your exam board.</p>
    </div>
  </section>
  <section class="block">
    <h2 class="sr-only">All subjects</h2>
    <div class="wrap grid grid-3">
      {subjects.map((s) => <SubjectCard s={s} />)}
    </div>
  </section>
  <LeadBlock text="Don’t see your subject or board? Ask anyway: our Partner Tutors network covers more A-level and GCSE subjects." />
</Base>
