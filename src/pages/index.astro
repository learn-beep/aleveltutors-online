---
import Base from '../layouts/Base.astro';
import SubjectCard from '../components/SubjectCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import LeadBlock from '../components/LeadBlock.astro';
import WaIcon from '../components/WaIcon.astro';
import subjects from '../data/subjects.json';
import reviews from '../data/reviews.json';
import { posts } from '../data/posts';
import { waGeneral } from '../lib';

const alevel = subjects.filter((s) => s.level !== 'GCSE');
const boardSections = alevel.reduce((n, s) => n + s.boards.length, 0);
const faqs = [
  { q: 'Who are the tutors?', a: 'Every tutor is an experienced A-level teacher. Most have taught A level for over 25 years in sixth form colleges, and many have marked for the exam boards. Each tutor teaches one subject and knows its specification inside out.' },
  { q: 'Are lessons online?', a: 'Yes. All lessons are one-to-one on Zoom or Google Meet. You see the same annotated slides, diagrams and exam questions as the tutor, and every lesson is recorded so you can watch it again when you revise.' },
  { q: 'Which exam boards do you cover?', a: `We cover AQA, OCR, Pearson Edexcel, Eduqas and Cambridge International across ${alevel.length} A-level subjects, plus GCSE Biology and Science. Each subject page lists the exact specifications.` },
  { q: 'How do I book?', a: 'Send us a WhatsApp message or the enquiry form with the subject, board and year group. We match you with the tutor, agree a regular weekly time, and the tutor contacts you before the first lesson to ask what you want to cover.' },
  { q: 'How much are lessons?', a: 'Most one-to-one lessons are £100 an hour. Further Maths is £110 an hour, and Maths lessons are £75 for 45 minutes. A-level Biology fees are on alevelbiologytutor.com.' },
  { q: 'How do I book a lesson?', a: 'Each subject page has a Book online button that opens the tutor’s calendar, so you can pick a time straight away. Or message us on WhatsApp and we’ll arrange it for you.' },
  { q: 'When do I pay?', a: 'A card secures the booking and is charged after each lesson, not in advance. You can move or stop lessons if your plans change.' },
  { q: 'Are the revision sites really free?', a: 'Yes. Every subject has a free site with past-paper questions sorted by topic, mark schemes, examiner comments, mock papers and practice tools. No sign-up and no adverts.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Online A-level Tutors | Experienced A-level Teachers | aleveltutors.online"
  description={`Online one-to-one A-level tutoring in ${alevel.map((s) => s.name).join(', ')} from experienced A-level teachers and examiners, with free revision sites for every subject.`}
  schema={[faqSchema]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">Online A-level tutors</div>
        <h1>A-level tutoring from teachers who teach A level every day</h1>
        <p class="lead">One-to-one online lessons with experienced A-level teachers and examiners, matched to your subject and exam board. Every lesson is recorded for revision.</p>
        <div class="btn-row">
          <a class="btn btn-wa" href={waGeneral()}><WaIcon /> WhatsApp us</a>
          <a class="btn btn-ghost" href="/subjects/">Choose a subject</a>
        </div>
      </div>
      <ul class="hero-facts">
        <li><strong>{alevel.length}</strong><span>A-level subjects, each with its own specialist tutor</span></li>
        <li><strong>{boardSections}</strong><span>exam board specifications covered, from AQA, OCR, Edexcel, Eduqas and Cambridge</span></li>
        <li><strong>25+</strong><span>years of A-level teaching for most of our tutors</span></li>
        <li><strong>Free</strong><span>revision site for every subject, with past-paper questions by topic</span></li>
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Subjects</div>
        <h2>Choose your subject</h2>
        <p class="muted">Each subject has a specialist tutor and a free revision site built around your exam board's past papers.</p>
      </div>
      <div class="grid grid-3">
        {subjects.map((s) => <SubjectCard s={s} />)}
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Why us</div>
        <h2>Experience matters</h2>
        <p class="muted">Subject knowledge is only the start. Our tutors know where students lose marks, how examiners read answers, and how to explain a hard idea in a way that sticks.</p>
      </div>
      <div class="features">
        <div>
          <h3><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg>A-level specialists</h3>
          <p>Our tutors teach A level, not a bit of everything. Most have more than 25 years of sixth form teaching, and many have been examiners.</p>
        </div>
        <div>
          <h3><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="m10 9 5 2.5-5 2.5Z"/></svg>Every lesson recorded</h3>
          <p>Lessons run on Zoom or Google Meet and are recorded, so you can stream any lesson again privately before a test or the exam.</p>
        </div>
        <div>
          <h3><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>Built on past papers</h3>
          <p>Lessons use real exam questions and mark schemes. Send in the questions you found hard and the tutor will go through them with you.</p>
        </div>
        <div>
          <h3><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Fits around school</h3>
          <p>Most students take a regular weekly slot. Lessons carry on in the holidays and wherever you are.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">How it works</div>
        <h2>Three steps to your first lesson</h2>
      </div>
      <ol class="steps">
        <li><h3>Tell us what you need</h3><p>WhatsApp or the enquiry form: subject, exam board, year group and the times that suit you.</p></li>
        <li><h3>Meet your tutor</h3><p>We match you with the specialist for your board. They get in touch before the first lesson to ask which topics to cover.</p></li>
        <li><h3>Learn and revise</h3><p>Weekly one-to-one lessons, recorded for revision, with the free revision site to practise between lessons.</p></li>
      </ol>
      <p style="margin-top:18px"><a href="/how-it-works/">More about how lessons work →</a></p>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Reviews</div>
        <h2>What students and parents say</h2>
      </div>
      <div class="grid grid-3">
        {reviews.map((r) => <ReviewCard r={r} />)}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Free revision</div>
        <h2>Free past-paper revision for every subject</h2>
        <p class="muted">Our revision sites sort every past-paper question by topic, with the mark scheme and examiner comments beside it, plus mock papers, specification checklists and practice tools.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href="/free-revision/">See all free revision sites</a>
        <a class="btn btn-ghost" href="/revision-tips/">Revision tips</a>
      </div>
      <h3 style="margin-top:32px">From the revision tips blog</h3>
      <div class="grid grid-3">
        {posts.map((p) => (
          <a class="card" href={`/revision-tips/${p.slug}/`} style="text-decoration:none;color:inherit">
            <h3>{p.title}</h3>
            <p class="muted" style="margin:0">{p.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap narrow">
      <h2>Questions</h2>
      {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <LeadBlock />
</Base>
