---
import Base from '../layouts/Base.astro';
import SubjectCard from '../components/SubjectCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import LeadBlock from '../components/LeadBlock.astro';
import WaIcon from '../components/WaIcon.astro';
import subjects from '../data/subjects.json';
import reviews from '../data/reviews.json';
import { posts } from '../data/posts';
import site from '../data/site.json';
import { waGeneral, teamStats } from '../lib';

const alevel = subjects.filter((s) => s.level !== 'GCSE');
const { tutors, examiners, heads } = teamStats();

const faqs = [
  { q: 'Who will be teaching?', a: `A specialist in that subject, never a student. Most of our ${tutors} tutors teach, or have taught, A level in sixth form colleges. ${examiners} have marked A-level exams for the exam boards and ${heads} have led a department. Each tutor’s experience is listed on their subject page.` },
  { q: 'How much does it cost?', a: 'Most lessons are £100 an hour. Further Maths with Emma is £110 an hour, and Maths with Tania is £75 for 45 minutes. There is nothing else to pay: no registration fee and no package to buy.' },
  { q: 'Do we have to commit to a block of lessons?', a: 'No. You pay for each lesson after it has happened. Most students keep the same weekly time, but you can move a lesson with reasonable notice, take a break over exams or holidays, or stop when you no longer need it.' },
  { q: 'Are tutors DBS checked?', a: 'Our tutors who currently teach in schools and colleges are DBS checked through their work. If a DBS check is important to you, ask Tom when you get in touch and he will tell you about your tutor.' },
  { q: 'Is it too late to start?', a: 'Students start at every point in the course, including the last few months before the exams. Later in the year, lessons concentrate on the topics and question types that carry the most marks.' },
  { q: 'How do online lessons work?', a: 'Lessons are one to one on Zoom or Google Meet. Tutor and student work on the same slides, diagrams and exam questions, and every lesson is recorded so it can be watched again when revising.' },
  { q: 'Which exam boards do you teach?', a: `AQA, OCR, Pearson Edexcel, Eduqas and Cambridge International, across ${alevel.length} A-level subjects, plus GCSE Science. Each subject page lists the exact specifications.` },
  { q: 'How do we book?', a: 'Most subject pages have a button that opens the tutor’s calendar, so you can choose a time straight away. For Chemistry, or if you would rather talk it through first, message Tom on WhatsApp. A-level Biology is booked on alevelbiologytutor.com.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const worries = [
  { h: 'The mock results were disappointing', p: 'It happens to capable students more often than people think, and it can usually be put right. A tutor finds exactly where the marks went and works through those topics, one at a time.' },
  { h: 'They understand it, but it doesn’t show in exams', p: 'Knowing the content and writing what the mark scheme rewards are different skills. Our examiners teach how answers are marked, so effort turns into marks.' },
  { h: 'Lessons at school have been disrupted', p: 'Staff changes, long absences and gaps in the timetable happen. A specialist can fill in what was missed and keep the course on track.' },
  { h: 'A university offer depends on the grade', p: 'Medicine, Law and other competitive courses ask for high grades. Lessons focus on the topics and questions that will make the biggest difference.' },
];
const ordered = [...reviews].sort((a, b) => (b.text.includes('Medicine') ? 1 : 0) - (a.text.includes('Medicine') ? 1 : 0));
---
<Base
  title="Online A-level Tutors | Experienced Teachers and Examiners"
  description={`One-to-one online A-level tutoring with experienced teachers and examiners in ${alevel.length} subjects. Lessons recorded. £100 an hour, paid after each lesson.`}
  schema={[faqSchema]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">Online A-level tutoring</div>
        <h1>Online A-level tutors: experienced teachers, one to one</h1>
        <p class="lead">When a university place depends on a grade, the right teacher makes a real difference. Our tutors are A-level specialists, heads of department and exam board examiners, and they know where marks are won and lost.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/subjects/">Find a tutor</a>
          <a class="btn btn-wa" href={waGeneral()}><WaIcon /> Ask Tom a question</a>
        </div>
      </div>
      <ul class="hero-facts">
        <li><strong>{tutors}</strong><span>specialist tutors, each teaching the subject they know best</span></li>
        <li><strong>{examiners}</strong><span>have marked A-level exams for the exam boards</span></li>
        <li><strong>{heads}</strong><span>have led a department</span></li>
        <li><strong>£100</strong><span>an hour for most subjects, paid after each lesson</span></li>
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">How we help</div>
        <h2>Does any of this sound familiar?</h2>
        <p class="muted">Families usually get in touch because of something like this. Each is something an experienced teacher can help with.</p>
      </div>
      <div class="grid grid-2">
        {worries.map((w) => <div class="card"><h3>{w.h}</h3><p class="muted" style="margin:0">{w.p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Subjects</div>
        <h2>Choose a subject</h2>
        <p class="muted">Each subject is taught by a specialist in that exam board. You can book straight into their calendar or ask us first.</p>
      </div>
      <div class="grid grid-3">
        {subjects.map((s) => <SubjectCard s={s} />)}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Why families choose us</div>
        <h2>Specialists, not students</h2>
        <p class="muted">Many tutoring websites list university students. Ours are experienced subject specialists who have spent years helping sixth formers through the same course and the same exams.</p>
      </div>
      <div class="features">
        <div>
          <h3><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg>They know the exam</h3>
          <p>Several of our tutors have marked the papers themselves. They teach students to answer the question that is asked, in the way the mark scheme rewards.</p>
        </div>
        <div>
          <h3><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="m10 9 5 2.5-5 2.5Z"/></svg>Every lesson recorded</h3>
          <p>Lessons are recorded, so explanations can be watched again before a test or in the final weeks of revision.</p>
        </div>
        <div>
          <h3><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>Clear fees, no contracts</h3>
          <p>One price per lesson, paid afterwards. No registration fee, no packages, and you can stop at any time.</p>
        </div>
        <div>
          <h3><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>A real person to talk to</h3>
          <p>aleveltutors.online is run by Tom Whitburn, an A-level Biology teacher of nearly 30 years. He reads every message himself.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Getting started</div>
        <h2>What happens next</h2>
      </div>
      <ol class="steps">
        <li><h3>Choose a time, or ask first</h3><p>Book into the tutor’s calendar from their subject page, or message Tom if you’d like advice on where to start.</p></li>
        <li><h3>The tutor gets in touch</h3><p>Before the first lesson they ask about the exam board, recent marks and the topics causing most trouble.</p></li>
        <li><h3>Regular lessons</h3><p>Most students keep a weekly slot. Every lesson is recorded, and you only pay once each lesson has happened.</p></li>
      </ol>
      <p style="margin-top:18px"><a href="/how-it-works/">More about how lessons work →</a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Reviews</div>
        <h2>What parents and students say</h2>
        <p class="muted">From our <a href={site.googleReviews} rel="noopener">Google reviews</a>.</p>
      </div>
      <div class="grid grid-3">
        {ordered.map((r) => <ReviewCard r={r} />)}
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap grid grid-2" style="align-items:start">
      <div>
        <div class="eyebrow">For students</div>
        <h2>Free past-paper practice</h2>
        <p class="muted">We have built a free revision site for most of the subjects we teach. Every past-paper question is sorted by topic, with the mark scheme and the examiners’ comments beside it. No sign-up and no adverts.</p>
        <a class="btn btn-primary" href="/free-revision/">Find your revision site</a>
      </div>
      <div>
        <h3>How to revise well</h3>
        <div class="post-list">
          {posts.map((p) => (
            <a class="card" href={`/revision-tips/${p.slug}/`}>
              <h3 style="margin-bottom:.3em">{p.title}</h3>
              <p>{p.description}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap narrow">
      <h2>Questions parents ask</h2>
      {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <LeadBlock />
</Base>
