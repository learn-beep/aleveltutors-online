---
import Base from '../layouts/Base.astro';
import LeadBlock from '../components/LeadBlock.astro';
import ReviewCard from '../components/ReviewCard.astro';
import WaIcon from '../components/WaIcon.astro';
import subjects from '../data/subjects.json';
import reviews from '../data/reviews.json';
import site from '../data/site.json';
import { waLink, host, joinList, acuityUrl } from '../lib';

export function getStaticPaths() {
  return subjects.map((s) => ({ params: { page: s.page }, props: { s } }));
}
const { s } = Astro.props;
const isGcse = s.level === 'GCSE';
const book = Object.entries(s.acuity ?? {}) as [string, number][];
const info = (s.tutorInfo ?? {}) as Record<string, string>;
const boardNames = s.boards.map((b) => b.short);
const wa = s.whatsapp ?? (s.boards.length === 1 ? waLink(s.boards[0].short, s.name) : waLink('', s.name));
const mine = reviews.filter((r) => r.subject.includes(s.name));
const others = subjects.filter((x) => x.slug !== s.slug);
const specHead = isGcse ? 'Specification' : 'Specification (A level / AS)';
const course = isGcse ? 'GCSE' : 'A-level';
const service = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: `Online ${s.label} tutoring`,
  serviceType: 'Tutoring',
  provider: { '@id': `${site.url}/#org` },
  areaServed: 'GB',
  description: `One-to-one online ${s.label} tutoring for ${joinList(s.boards.map((b) => b.board))}.`,
  url: `${site.url}/${s.page}/`,
};
const crumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Subjects', item: `${site.url}/subjects/` },
    { '@type': 'ListItem', position: 2, name: `${s.label} tutor`, item: `${site.url}/${s.page}/` },
  ],
};
const helps = [
  `Finding and filling the gaps behind a disappointing mock or test`,
  `Exam technique: reading the question, planning an answer and writing what the mark scheme rewards`,
  `Past-paper questions on the topics that cause most trouble, marked the way examiners mark them`,
  isGcse ? `Building confidence and good habits before A level` : `Steady preparation in the final months before the exams`,
];
const acu = (s.acuity ?? {}) as Record<string, number>;
const cards = s.tutors.map((t) => ({ t, id: acu[t] }));
const feeLine = s.fee ? `${s.fee[0].toUpperCase()}${s.fee.slice(1)}, paid after each lesson. ` : '';
---
<Base
  title={[`Online ${s.label} Tutor | ${joinList(boardNames)} | aleveltutors.online`, `Online ${s.label} Tutor | ${joinList(boardNames)}`, `Online ${s.label} Tutor | aleveltutors.online`, `Online ${s.label} Tutor`].find((t) => t.length <= 65)}
  description={`One-to-one online ${s.label} tutoring for ${joinList(boardNames)} with ${joinList(s.tutors)}. ${feeLine}Every lesson recorded.`}
  schema={[service, crumbs]}
>
  <section class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href="/subjects/">Subjects</a> › {s.name}</div>
      <h1>Online {s.label} tutor</h1>
      <p>{s.blurb}</p>
      <div class="btn-row" style="margin-top:20px">
        {s.external && <a class="btn btn-primary" href={`${s.site}/`}>Book on {host(s.site!)}</a>}
        {book.map(([t, id]) => <a class="btn btn-primary" href={acuityUrl(id)}>Book with {t}</a>)}
        {!s.external && <a class="btn btn-wa" href={wa}><WaIcon /> Ask a question first</a>}
        {s.site && <a class="btn btn-ghost" style="color:#fff" href={`${s.site}/`}>Free {s.name} revision ↗</a>}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>{s.tutors.length > 1 ? 'Your tutors' : 'Your tutor'}</h2>
      <div class="grid grid-2">
        {cards.map(({ t, id }) => (
            <article class="card subject-card">
              <h3>{t}{s.slug === 'biology' ? ' Whitburn' : ''}</h3>
              <p style="color:var(--ink)">{info[t]}</p>
              {s.fee && <p><strong>{s.fee}</strong>, online and one to one, paid after each lesson.</p>}
              <div class="links">
                {id && <a href={acuityUrl(id)}>See {t}’s free times ↗</a>}
                {(s.tutorUrl || s.site) && <a href={s.tutorUrl ?? `${s.site}/tutors/`}>Full profile ↗</a>}
              </div>
            </article>
        ))}
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap grid grid-2">
      <div>
        <h2>How lessons help</h2>
        <ul>{helps.map((h) => <li>{h}</li>)}</ul>
      </div>
      <div>
        <h2>What to expect</h2>
        <ul>
          <li>Before the first lesson, {s.tutors.length > 1 ? 'your tutor asks' : `${s.tutors[0]} asks`} about recent marks and the topics causing most trouble</li>
          <li>One-to-one lessons on Zoom or Google Meet, usually at the same time each week</li>
          <li>Every lesson recorded, so it can be watched again when revising</li>
          <li>No contract: move a lesson with reasonable notice, or stop at any time</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <h2>Exam boards</h2>
        <p class="muted">Lessons follow your exact {course} specification.{s.site && !s.external && ' Each board also has its own free revision section, with every past-paper question sorted by topic and the mark scheme beside it.'}</p>
      </div>
      <div class="table-wrap">
        <table class="stack">
          <thead><tr><th>Exam board</th><th>{specHead}</th>{s.site && <th>Free revision</th>}</tr></thead>
          <tbody>
            {s.boards.map((b) => (
              <tr>
                <td data-label="Exam board"><strong>{b.board}</strong>{b.note && <div class="muted">{b.note}</div>}</td>
                <td data-label="Specification">{b.codes}</td>
                {s.site && <td data-label="Free revision"><a href={`${s.site}${b.path}`}>{host(s.site)}{b.path === '/' ? '' : b.path.replace(/\/$/, '')} ↗</a></td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {mine.length > 0 && (
    <section class="block alt">
      <div class="wrap">
        <h2>What families say</h2>
        <div class="grid grid-3">{mine.map((r) => <ReviewCard r={r} />)}</div>
      </div>
    </section>
  )}

  <LeadBlock
    heading={s.external ? `A-level ${s.name} with Tom` : 'Would you like to talk it through first?'}
    text={s.external ? `A-level ${s.name} one-to-one lessons and weekly group masterclasses are booked on ${host(s.site!)}.` : `Message Tom with the exam board, year group and what’s worrying you. He’ll check it’s the right fit and help you arrange a first lesson with ${joinList(s.tutors)}.`}
    wa={wa}
  />

  <section class="block alt">
    <div class="wrap">
      <h2>Other subjects</h2>
      <div class="tags">{others.map((o) => <a class="tag" href={`/${o.page}/`} style="text-decoration:none">{o.name}</a>)}</div>
    </div>
  </section>
</Base>
