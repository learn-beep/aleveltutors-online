---
import Base from '../layouts/Base.astro';
import LeadBlock from '../components/LeadBlock.astro';
import ReviewCard from '../components/ReviewCard.astro';
import WaIcon from '../components/WaIcon.astro';
import subjects from '../data/subjects.json';
import reviews from '../data/reviews.json';
import site from '../data/site.json';
import { waLink, host, joinList } from '../lib';

export function getStaticPaths() {
  return subjects.map((s) => ({ params: { page: s.page }, props: { s } }));
}
const { s } = Astro.props;
const boardNames = s.boards.map((b) => b.short);
const wa = s.whatsapp ?? (s.boards.length === 1 ? waLink(s.boards[0].short, s.name) : waLink('', s.name));
const mine = reviews.filter((r) => r.subject.includes(s.name));
const others = subjects.filter((x) => x.slug !== s.slug);
const service = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: `Online A-level ${s.name} tutoring`,
  serviceType: 'Tutoring',
  provider: { '@id': `${site.url}/#org` },
  areaServed: 'GB',
  description: `One-to-one online A-level ${s.name} tutoring for ${joinList(s.boards.map((b) => b.board))}.`,
  url: `${site.url}/${s.page}/`,
};
const crumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Subjects', item: `${site.url}/subjects/` },
    { '@type': 'ListItem', position: 2, name: `A-level ${s.name} tutor`, item: `${site.url}/${s.page}/` },
  ],
};
---
<Base
  title={`Online A-level ${s.name} Tutor | ${joinList(boardNames)} | aleveltutors.online`}
  description={`One-to-one online A-level ${s.name} tutoring for ${joinList(boardNames)} from an experienced A-level teacher. Recorded lessons and a free ${s.name} revision site.`}
  schema={[service, crumbs]}
>
  <section class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href="/subjects/">Subjects</a> › {s.name}</div>
      <h1>Online A-level {s.name} tutor</h1>
      <p>{s.blurb}</p>
      <div class="btn-row" style="margin-top:20px">
        {s.external
          ? <a class="btn btn-primary" href={`${s.site}/`}>Book on {host(s.site)}</a>
          : <a class="btn btn-wa" href={wa}><WaIcon /> WhatsApp about {s.name}</a>}
        <a class="btn btn-ghost" style="color:#fff" href={`${s.site}/`}>Free {s.name} revision ↗</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <h2>Exam boards we teach</h2>
        <p class="muted">Lessons follow your exact specification. Each board has its own section of the free revision site with past-paper questions by topic, mark schemes and examiner comments.</p>
      </div>
      <div class="table-wrap">
        <table class="stack">
          <thead><tr><th>Exam board</th><th>Specification (A level / AS)</th><th>Free revision</th></tr></thead>
          <tbody>
            {s.boards.map((b) => (
              <tr>
                <td data-label="Exam board"><strong>{b.board}</strong>{b.note && <div class="muted">{b.note}</div>}</td>
                <td data-label="Specification">{b.codes}</td>
                <td data-label="Free revision"><a href={`${s.site}${b.path}`}>{host(s.site)}{b.path === '/' ? '' : b.path.replace(/\/$/, '')} ↗</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap grid grid-2">
      <div>
        <h2>Your tutor</h2>
        <p>A-level {s.name} is taught by <strong>{joinList(s.tutors)}</strong>{s.slug === 'biology' ? ' Whitburn, who founded aleveltutors.online' : ''}, an experienced A-level teacher who knows the {joinList(boardNames)} {s.boards.length > 1 ? 'specifications' : 'specification'} and how examiners mark them.</p>
        <p><a href={s.tutorUrl ?? `${s.site}/tutors/`}>Read more about {s.tutors.length > 1 ? 'the tutors' : s.tutors[0]} ↗</a></p>
      </div>
      <div>
        <h2>What lessons include</h2>
        <ul>
          <li>One-to-one lessons on Zoom or Google Meet at a regular weekly time</li>
          <li>Every lesson recorded so you can watch it again</li>
          <li>Past-paper questions on the topics you find hardest, marked the way examiners mark</li>
          <li>Resources before each lesson, and a place to send questions you got stuck on</li>
        </ul>
      </div>
    </div>
  </section>

  {mine.length > 0 && (
    <section class="block">
      <div class="wrap">
        <h2>Reviews</h2>
        <div class="grid grid-3">{mine.map((r) => <ReviewCard r={r} />)}</div>
      </div>
    </section>
  )}

  <LeadBlock
    heading={`Find your ${s.name} tutor`}
    text={s.external ? `A-level ${s.name} lessons and group masterclasses are booked on ${host(s.site)}.` : `Tell us the exam board, year group and the times that suit you, and we’ll arrange a first lesson with ${joinList(s.tutors)}.`}
    wa={wa}
  />

  <section class="block alt">
    <div class="wrap">
      <h2>Other subjects</h2>
      <div class="tags">{others.map((o) => <a class="tag" href={`/${o.page}/`} style="text-decoration:none">{o.name}</a>)}</div>
    </div>
  </section>
</Base>
